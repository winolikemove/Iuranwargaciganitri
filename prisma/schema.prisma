// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id           String   @id @default(cuid())
  nama         String
  email        String   @unique
  passwordHash String
  nik          String   @unique
  telepon      String
  blok         String   // A, B, etc
  nomorRumah   String
  role         String   @default("WARGA") // SUPERADMIN, ADMIN, BENDAHARA, WARGA
  status       String   @default("PENDING") // PENDING, ACTIVE, REJECTED, BLOCKED
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  transactions  Transaction[]
  payments      Payment[]
  agendas       Agenda[]
  informations  Information[]
  galleries     Gallery[]
  reviews       Review[]
}

// Finance - Transactions
model Transaction {
  id          String   @id @default(cuid())
  blok        String   // A, B, etc
  type        String   // INCOME, EXPENSE
  category    String
  amount      Int
  description String
  date        String
  createdBy   String
  createdAt   DateTime @default(now())

  user User? @relation(fields: [createdById], references: [id])
  createdById String?
}

// Finance - Payments (Iuran)
model Payment {
  id            String   @id @default(cuid())
  userId        String
  userName      String
  blok          String
  nomorRumah    String
  periods       String   // JSON array of periods ["2024-01", "2024-02"]
  amount        Int
  buktiUrl      String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  processedBy   String?
  processedAt   String?
  rejectReason  String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Agenda/Kegiatan
model Agenda {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   String
  endDate     String?
  startTime   String?
  endTime     String?
  status      String   @default("UPCOMING") // UPCOMING, ONGOING, COMPLETED, CANCELLED
  targetBlok  String   @default("ALL") // ALL, A, B
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User       @relation(fields: [createdById], references: [id])
  gallery Gallery[]
  createdById String
}

// Information/Pengumuman
model Information {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("UMUM")
  isPinned    Boolean  @default(false)
  targetBlok  String   @default("ALL") // ALL, A, B
  publishedAt String
  expiredAt   String?
  createdBy   String
  createdAt   DateTime @default(now())

  user User @relation(fields: [createdById], references: [id])
  createdById String
}

// Gallery/Dokumentasi
model Gallery {
  id           String   @id @default(cuid())
  agendaId     String?
  title        String
  description  String?
  imageUrl     String
  thumbnailUrl String?
  takenAt      String?
  uploadedBy   String
  createdAt    DateTime @default(now())

  agenda Agenda? @relation(fields: [agendaId], references: [id])
  user   User    @relation(fields: [uploadedById], references: [id])
  uploadedById String
}

// Reviews/Testimoni
model Review {
  id           String   @id @default(cuid())
  userId       String
  userName     String
  userPhotoUrl String?
  rating       Int      // 1-5
  comment      String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// Settings
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Role Permissions
model Permission {
  role        String   @id
  permissions String   // JSON string
  updatedAt   DateTime @updatedAt
}

// Saldo Awal per Blok per Tahun
model SaldoAwal {
  id        String   @id @default(cuid())
  blok      String   // A, B
  year      String
  amount    Int
  createdAt DateTime @default(now())

  @@unique([blok, year])
}
